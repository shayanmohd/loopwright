# Signing material. Never commit these; the upload key cannot be replaced.
*.jks
*.keystore
keystore.properties
local.properties

# Build output
android/.gradle/
android/build/
android/app/build/
android/captures/
*.apk
*.aab
*.ap_
*.dex

# The web core is copied into the shell at build time; the copy is not source.
android/app/src/main/assets/www/

# Editors and the operating system
.idea/
*.iml
.DS_Store

# Drive-script screenshots are regenerated on demand, not source.
test/shots/
test/shots-rm/
